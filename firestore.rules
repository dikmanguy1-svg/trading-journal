rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the owner, signed in with Google or with email and password (12.11), may read or write.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 700000
        && request.resource.data.updated is number;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
